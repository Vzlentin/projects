{
	"name": "@vzlentin/projects",
	"version": "0.0.0",
	"description": "The project store of the harness stack: projects, work items, parleys and contracts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/projects.git"
	},
	"bin": {
		"projects": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./entry": {
			"types": "./dist/projects/index.d.ts",
			"default": "./dist/projects/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"prepare": "npm run build",
		"prepack": "npm run build",
		"check": "npm run build && vp check --deny-warnings && tsc -p tsconfig.json && vp test",
		"test": "vp test"
	},
	"dependencies": {
		"@earendil-works/chord": "1.6.0",
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-codemode": "1.6.0",
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@earendil-works/pi-durable": "1.6.0",
		"@earendil-works/pi-mcp": "1.6.0",
		"@earendil-works/pi-tui": "1.6.0",
		"@vzlentin/harness": "git+https://github.com/Vzlentin/harness.git#5a676bad8d6076b5bdacc341bbafaf573d2f6187",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
